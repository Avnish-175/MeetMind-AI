APP_NAME=MeetMind AI
APP_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/meetmind_db
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_UPLOAD_SIZE_MB=200

# Media Processing (FFmpeg)
FFMPEG_PATH=ffmpeg

# Local Transcription (Faster-Whisper)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_DOWNLOAD_ROOT=

# Local LLM Intelligence (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Local Embeddings (Sentence Transformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu

# Vector Storage (ChromaDB)
CHROMA_PERSIST_DIRECTORY=storage/vector_db/chroma
CHROMA_COLLECTION_NAME=meeting_chunks

# Retrieval-Augmented Generation (RAG)
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.25

